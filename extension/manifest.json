{
  "manifest_version": 3,
  "name": "PRIVON",
  "version": "0.3.2",
  "description": "PRIVON mechanical browser authorization runtime. No page content, DOM, or clipboard access of any kind.",
  "permissions": ["nativeMessaging"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/privon-16.png",
    "32": "icons/privon-32.png",
    "48": "icons/privon-48.png",
    "128": "icons/privon-128.png"
  },
  "minimum_chrome_version": "116"
}
